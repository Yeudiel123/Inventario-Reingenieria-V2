<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="mx.unison.controladores.LoginController" stylesheets="@estilos.css" styleClass="login-shell">
    <VBox alignment="CENTER_LEFT" spacing="22" maxWidth="380" maxHeight="-Infinity" styleClass="login-card">
        <VBox spacing="8">
            <Label text="INVENTARIO / UNISON" styleClass="eyebrow"/>
            <Label fx:id="lblTitulo" text="Bienvenido" styleClass="login-title" wrapText="true"/>
            <Label fx:id="lblSubtitulo" text="Ingresa a tu espacio de trabajo." styleClass="muted" wrapText="true"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Usuario" styleClass="field-label"/>
            <TextField fx:id="txtUsuario" promptText="Escribe tu usuario" accessibleText="Usuario"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtPassword" promptText="Escribe tu contraseña" accessibleText="Contraseña"/>
        </VBox>
        <VBox fx:id="panelConfirmacion" spacing="8" visible="false" managed="false">
            <Label text="Confirmar contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtConfirmarPassword" promptText="Repite tu contraseña" accessibleText="Confirmar contraseña"/>
        </VBox>
        <Label fx:id="lblMensaje" text="" wrapText="true" maxWidth="Infinity" styleClass="message-error"/>
        <Button fx:id="btnAcceder" text="Iniciar sesión" onAction="#onLoginButtonClick"
                defaultButton="true" maxWidth="Infinity" styleClass="primary-button"/>
        <Label text="Gestión de productos y almacenes" styleClass="caption" wrapText="true"/>
    </VBox>
</StackPane>
