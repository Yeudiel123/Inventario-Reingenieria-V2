<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="24" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.unison.controladores.ConfiguracionController" stylesheets="@estilos.css" styleClass="page">
    <VBox spacing="7">
        <Label text="Mi contraseña" styleClass="page-title"/>
        <Label text="Actualiza la contraseña de la cuenta con la que iniciaste sesión." styleClass="muted" wrapText="true"/>
    </VBox>
    <VBox spacing="20" maxWidth="440" styleClass="card">
        <VBox spacing="8">
            <Label text="Contraseña actual" styleClass="field-label"/>
            <PasswordField fx:id="txtPasswordActual" promptText="Tu contraseña actual" accessibleText="Contraseña actual"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Nueva contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtNuevaPass" promptText="Entre 12 y 128 caracteres" accessibleText="Nueva contraseña"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Confirmar nueva contraseña" styleClass="field-label"/>
            <PasswordField fx:id="txtConfirmarPass" promptText="Repite la nueva contraseña" accessibleText="Confirmar nueva contraseña"/>
        </VBox>
        <Button text="Actualizar contraseña" onAction="#cambiarPassword" styleClass="primary-button" maxWidth="Infinity"/>
        <Label text="El cambio se aplica a tu cuenta. Usa la nueva contraseña la próxima vez que inicies sesión." styleClass="caption" wrapText="true"/>
    </VBox>
</VBox>
